          {
            "urn": "urn:li:query:coldlineage-claims_history-claims_denial_rate_chart",
            "properties": {
              "name": "Claims Denial Rate by Reason -- claims_history",
              "description": "Monthly denial counts by CARC reason. Retired when claims moved platforms.",
              "source": "SYSTEM",
              "statement": {
                "value": "SELECT date_trunc('month', c.service_date)::date AS month_start,\n       c.denial_reason,\n       count(*) AS denied_claims\nFROM public.claims_history c\nWHERE c.claim_status = 'DENIED'\n  AND c.service_date BETWEEN DATE '2023-01-01' AND CURRENT_DATE\nGROUP BY 1, 2",
                "language": "SQL"
              },
