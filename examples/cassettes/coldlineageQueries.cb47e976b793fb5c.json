          {
            "urn": "urn:li:query:coldlineage-lab_results-hipaa_lab_disclosure_extract",
            "properties": {
              "name": "hipaa_lab_disclosure_extract -- lab_results",
              "description": "Quarterly HIPAA accounting-of-disclosures extract. Regulators can request the full disclosure history for any patient, so this job reads every row that has ever been written -- there is no date predicate and there cannot be one.",
              "source": "SYSTEM",
              "statement": {
                "value": "SELECT r.result_id,\n       r.patient_id,\n       r.specimen_id,\n       r.collected_date,\n       r.resulted_at,\n       r.loinc_code,\n       r.analyte,\n       r.result_value,\n       r.result_units,\n       r.abnormal_flag,\n       r.performing_lab\nFROM public.lab_results r\nWHERE r.performing_lab IS NOT NULL\nORDER BY r.collected_date",
                "language": "SQL"
              },
