            "urn": "urn:li:query:coldlineage-billing_ledger-finance_close_dashboard",
            "properties": {
              "name": "Monthly Finance Close -- billing_ledger",
              "description": "Close-package debits and credits by cost centre for the current fiscal year.",
              "source": "SYSTEM",
              "statement": {
                "value": "SELECT b.cost_center,\n       b.gl_account,\n       sum(b.debit_amount)  AS debits,\n       sum(b.credit_amount) AS credits\nFROM public.billing_ledger b\nWHERE b.posted_date >= DATE '2025-08-01'\nGROUP BY 1, 2",
