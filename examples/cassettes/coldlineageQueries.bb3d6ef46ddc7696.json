          {
            "urn": "urn:li:query:coldlineage-billing_ledger-ar_aging_chart",
            "properties": {
              "name": "AR Aging Buckets -- billing_ledger",
              "description": "Open balance by cost centre and age for unreconciled entries.",
              "source": "SYSTEM",
              "statement": {
                "value": "SELECT b.cost_center,\n       CURRENT_DATE - b.posted_date                 AS age_days,\n       sum(b.debit_amount - b.credit_amount)        AS open_balance\nFROM public.billing_ledger b\nWHERE b.posted_date >= CURRENT_DATE - INTERVAL '90 days'\n  AND b.reconciled IS FALSE\nGROUP BY 1, 2",
                "language": "SQL"
              },
