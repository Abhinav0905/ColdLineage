            "urn": "urn:li:query:coldlineage-care_events_live-care_events_hourly_rollup",
            "properties": {
              "name": "care_events_hourly_rollup -- care_events_live",
              "description": "Hourly event counts by unit. Rebuilt every 30 minutes over a 30-day window.",
              "source": "SYSTEM",
              "statement": {
                "value": "SELECT date_trunc('hour', v.event_ts) AS hour_start,\n       v.unit,\n       v.event_type,\n       count(*) AS events\nFROM public.care_events_live v\nWHERE v.event_date >= CURRENT_DATE - INTERVAL '30 days'\nGROUP BY 1, 2, 3",
