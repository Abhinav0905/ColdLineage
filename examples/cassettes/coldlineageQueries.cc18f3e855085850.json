          {
            "urn": "urn:li:query:coldlineage-patient_encounters-care_gap_closure_chart",
            "properties": {
              "name": "Care Gap Closure Rate -- patient_encounters",
              "description": "Preventive-encounter share by diagnosis for the current plan year.",
              "source": "SYSTEM",
              "statement": {
                "value": "SELECT e.primary_diagnosis_code,\n       count(*) FILTER (WHERE e.encounter_type = 'preventive') AS preventive_encounters,\n       count(*)                                                AS total_encounters\nFROM public.patient_encounters e\nWHERE e.event_date >= DATE '2025-08-01'\nGROUP BY e.primary_diagnosis_code\nORDER BY total_encounters DESC\nLIMIT 25",
                "language": "SQL"
              },
