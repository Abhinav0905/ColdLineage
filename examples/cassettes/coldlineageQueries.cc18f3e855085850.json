          {
            "urn": "urn:li:query:coldlineage-patient_encounters-quarterly_compliance_dashboard",
            "properties": {
              "name": "Quarterly Compliance Dashboard -- patient_encounters",
              "description": "Quarterly encounter-volume and charge attestation reviewed by the compliance committee. Reaches back to the start of the current attestation cycle.",
              "source": "SYSTEM",
              "statement": {
                "value": "SELECT e.region,\n       e.encounter_type,\n       date_trunc('quarter', e.event_date)::date AS quarter_start,\n       count(*)                                  AS encounters,\n       sum(e.total_charges)                      AS total_charges\nFROM public.patient_encounters e\nWHERE e.event_date BETWEEN DATE '2024-01-01' AND CURRENT_DATE\nGROUP BY 1, 2, 3\nORDER BY 3 DESC, 1",
                "language": "SQL"
