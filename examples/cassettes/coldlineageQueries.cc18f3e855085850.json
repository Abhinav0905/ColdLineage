          {
            "urn": "urn:li:query:coldlineage-patient_encounters-encounters_monthly_agg",
            "properties": {
              "name": "encounters_monthly_agg -- patient_encounters",
              "description": "Incremental dbt model rolling encounters up to department-month. Rebuilds an 18-month trailing window each night.",
              "source": "SYSTEM",
              "statement": {
                "value": "SELECT date_trunc('month', e.event_date)::date AS month_start,\n       e.department,\n       e.payer,\n       count(*)             AS encounters,\n       sum(e.total_charges) AS charges\nFROM public.patient_encounters e\nWHERE date_trunc('month', e.event_date) >= date_trunc('month', CURRENT_DATE - INTERVAL '18 months')\nGROUP BY 1, 2, 3",
                "language": "SQL"
              },
