          {
            "urn": "urn:li:query:coldlineage-patient_encounters-encounter_readmission_etl",
            "properties": {
              "name": "encounter_readmission_etl -- patient_encounters",
              "description": "Daily 30-day readmission flagging job. Only looks at the recent tail.",
              "source": "SYSTEM",
              "statement": {
                "value": "SELECT e.patient_id,\n       e.event_date,\n       e.department,\n       e.length_of_stay_days,\n       lead(e.event_date) OVER (PARTITION BY e.patient_id ORDER BY e.event_date) AS next_event_date\nFROM public.patient_encounters e\nWHERE e.event_date >= CURRENT_DATE - INTERVAL '90 days'",
                "language": "SQL"
