          {
            "urn": "urn:li:query:coldlineage-patient_encounters-patient_ltv_model",
            "properties": {
              "name": "Patient Lifetime Value Model -- patient_encounters",
              "description": "Gradient-boosted lifetime-value estimate used for outreach prioritisation. Retrained monthly on a rolling 24-month window.",
              "source": "SYSTEM",
              "statement": {
                "value": "SELECT e.patient_id,\n       count(*)                   AS encounter_count,\n       sum(e.total_charges)       AS lifetime_charges,\n       avg(e.length_of_stay_days) AS avg_length_of_stay,\n       max(e.event_date)          AS last_seen\nFROM public.patient_encounters e\nWHERE e.event_date > (NOW() - INTERVAL '24 months')::date\nGROUP BY e.patient_id",
                "language": "SQL"
              },
