# Copy to .env and edit. docker compose reads .env from this directory automatically.
#
# Only set these if the defaults collide with something already running on your machine.
# The defaults are the standard ports: DataHub GMS on 8080, the ColdLineage UI on 3000.

# Where DataHub GMS is reachable FROM INSIDE the backend container.
# `datahub docker quickstart` publishes GMS on host port 8080 by default.
# If 8080 is taken, republish GMS elsewhere and point this at it, e.g. :8090.
DATAHUB_GMS_URL=http://host.docker.internal:8080

# live   -- read and write a real DataHub (default; what you want)
# replay -- serve the verbatim recorded GMS responses in examples/cassettes/,
#           so the demo runs with no DataHub at all. The UI labels the mode and
#           the recording timestamp. No mode invents context.
DATAHUB_MODE=live

# Only needed if your DataHub has metadata auth enabled.
DATAHUB_TOKEN=

# Host port for the ColdLineage UI.
UI_PORT=3000
